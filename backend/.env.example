# Copy to backend/.env and fill in. Everything here is free.

# --- LLM: any OpenAI-compatible endpoint. Groq free tier: https://console.groq.com/keys ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Comma-separated: calls rotate between models and skip any that hit their rate limit
LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_CONCURRENCY=2

# --- Backup LLM (optional): used automatically when every Groq model is rate-limited ---
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Vector DB: Pinecone (free Starter plan). Leave empty to use the local index. ---
PINECONE_API_KEY=
PINECONE_INDEX=insightai-reviews
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Data ---
SAMPLE_SIZE=5000

# --- API ---
CORS_ORIGINS=*
