# Copy to backend/.env and fill in. Everything here is free.

# --- LLM: any OpenAI-compatible endpoint ---
# FreeLLMAPI (self-hosted router over free tiers): https://github.com/tashfeenahmed/freellmapi
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=your-freellmapi-unified-key
LLM_MODEL=auto
# Alternatives (for a hosted deployment, where localhost:3001 doesn't exist):
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
LLM_CONCURRENCY=3

# --- Vector DB: Pinecone (free Starter plan). Leave empty to use the local index. ---
PINECONE_API_KEY=
PINECONE_INDEX=insightai-reviews
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Data ---
SAMPLE_SIZE=5000

# --- API ---
CORS_ORIGINS=*
