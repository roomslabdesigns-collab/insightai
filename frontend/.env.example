# Server-side only (used by the /api routes). On Vercel: Project Settings -> Environment Variables.
# Visitors never see these keys.

# LLM: Groq free tier (https://console.groq.com/keys). Calls rotate between these models.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Backup LLM, used automatically when Groq is rate-limited (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Vector DB + hosted embeddings (https://app.pinecone.io). The index is created automatically.
PINECONE_API_KEY=
PINECONE_INDEX=insightai-feedback
